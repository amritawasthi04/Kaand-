# Google Gemini API key for summaries
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK credentials for serverless firestore cache
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Guardian open developer platform API key
GUARDIAN_API_KEY=cd760a37-962a-475d-a08f-75738e87a663

# --- PERFORMANCE & TUNING PARAMETERS ---

# Pagination constraints
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=500

# Concurrency configurations
MAX_CONCURRENT_RSS=10
MAX_CONCURRENT_SCRAPE=5

# Timeout parameters (in milliseconds)
RSS_TIMEOUT_MS=10000
SCRAPER_TIMEOUT_MS=4000
AI_TIMEOUT_MS=15000

# Cache TTL parameters (in seconds)
FEED_CACHE_TTL=900
ARTICLE_CACHE_TTL=86400

# Bypass caching (e.g. for development environment local testing)
DISABLE_CACHE=false

# AI Content Generation Constraints
MAX_SUMMARY_WORDS=120
MAX_SUMMARY_CHARS=300
MAX_AI_TOKENS=2048

# Verbose logging output to console (true/false)
LOG_VERBOSE=false
